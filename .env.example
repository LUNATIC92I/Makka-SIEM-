# MAKKADi — configuration (copier en backend/.env ou dans le dossier de données).
# Toutes les variables sont optionnelles. Les clés d'API des sources OSINT/SIEM se saisissent
# dans l'interface (Connecteurs) : elles sont chiffrées et ne doivent PAS être mises ici.

# --- Marque -------------------------------------------------------------
MAKKADI_APP_NAME=MAKKADi
MAKKADI_APP_TAGLINE=OSINT Intelligence for SOC analysts

# --- Réseau (écoute locale uniquement par défaut) ------------------------
MAKKADI_HOST=127.0.0.1
MAKKADI_PORT=8765
MAKKADI_ALLOW_REMOTE_BIND=false
# Origines autorisées (développement uniquement), ex. ["http://127.0.0.1:5173"]
MAKKADI_CORS_ORIGINS=[]

# --- Données -------------------------------------------------------------
# Défaut : %APPDATA%\MAKKADi (Windows) ou ~/.makkadi
# MAKKADI_DATA_DIR=
# SQLite par défaut ; PostgreSQL : postgresql+psycopg://user:pass@host:5432/makkadi
# MAKKADI_DATABASE_URL=
MAKKADI_RETENTION_DAYS=365

# --- Sécurité ------------------------------------------------------------
# Générés automatiquement dans le dossier de données s'ils sont absents.
# MAKKADI_JWT_SECRET=
# MAKKADI_MASTER_KEY=          # clé Fernet (chiffrement des secrets des connecteurs)
MAKKADI_ACCESS_TOKEN_TTL_MINUTES=60
MAKKADI_MAX_FAILED_LOGINS=5
MAKKADI_LOCKOUT_MINUTES=15
MAKKADI_RATE_LIMIT_PER_MINUTE=240
MAKKADI_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Destinations internes autorisées pour les connecteurs (SIEM sur site) — sinon refusées (anti-SSRF)
MAKKADI_OUTBOUND_ALLOWED_HOSTS=[]
MAKKADI_OUTBOUND_ALLOWED_CIDRS=[]

# --- Fonctionnement ------------------------------------------------------
MAKKADI_DEMO_MODE=true
MAKKADI_WORKER_ENABLED=true
MAKKADI_SCHEDULER_TICK_SECONDS=15
MAKKADI_HTTP_TIMEOUT_SECONDS=20

# --- Mode actif (désactivé par défaut, périmètre explicitement autorisé) --
MAKKADI_ACTIVE_CHECKS_ENABLED=false
MAKKADI_ACTIVE_CHECKS_ALLOWED_CIDRS=[]
MAKKADI_ACTIVE_CHECKS_ALLOWED_PORTS=[22,80,443,3389]

# --- IA ------------------------------------------------------------------
# none | deterministic | anthropic | openai_compatible (peut aussi se configurer dans l'interface)
MAKKADI_AI_PROVIDER=deterministic
# MAKKADI_AI_MODEL=claude-opus-5-5
# MAKKADI_AI_BASE_URL=http://127.0.0.1:11434/v1
# Doit être true pour envoyer des données (minimisées) à un fournisseur IA non local.
MAKKADI_AI_EXTERNAL_PROCESSING_ALLOWED=false
MAKKADI_AI_PSEUDONYMIZE=true
