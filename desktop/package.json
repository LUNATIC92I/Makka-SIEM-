{
  "name": "makkadi-desktop",
  "productName": "MAKKADi",
  "version": "0.1.0",
  "description": "MAKKADi — investigation OSINT assistée par IA pour analystes SOC",
  "main": "src/main.js",
  "author": "MAKKADi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.makkadi.osint",
    "productName": "MAKKADi",
    "copyright": "MAKKADi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend/makkadi-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extra/Reinitialiser-mot-de-passe.cmd",
        "to": "Reinitialiser-mot-de-passe.cmd"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MAKKADi",
      "uninstallDisplayName": "MAKKADi",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "publish": null,
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
